---
const stages = [
  { grow: 2, time: 'About a week', lead: 'First, we watch the task:', text: 'one or two short sessions, then a written plan.' },
  { grow: 3, time: 'A few weeks', lead: 'Then we build it', text: 'against your real data, and run it beside the person who does the job until they trust the drafts.' },
  { grow: 5, time: 'Every week after', lead: 'From then on, it drafts and you approve.', text: 'Nothing reaches a client without a yes from your side. We keep it running and make it better.' },
];
const tokens = ['Your notes', 'A workflow', 'Approved'];
---
<section id="how" class="how" aria-labelledby="how-title" data-how>
  <div class="how__pin wrap">
    <div class="how__head" data-reveal-group>
      <h2 class="headline" id="how-title" data-reveal="clip">How it works</h2>
      <p class="how__sub" data-reveal>Three stages, from your first call to a workflow that runs every week. You stay in charge of each one.</p>
    </div>
    <div class="how__track">
      <p class="how__token" data-token aria-hidden="true"><span data-token-label>{tokens[0]}</span></p>
      <ol class="bar" data-ui>
        {stages.map((s, i) => (
          <li class={`seg seg--${i + 1} is-filled`} style={`--grow:${s.grow}`}>
            <div class="seg__block" aria-hidden="true">
              <span class="seg__time">{s.time}</span>
              <div class="seg__fill" data-fill>
              {i === 0 && (
                <div class="art art--notes" data-ui>
                  <span>#4812 customs hold</span><span>ETA again??</span><span>send weekly update</span>
                </div>
              )}
              {i === 1 && (
                <div class="art art--spec" data-ui>
                  <b>Workflow: weekly client report</b>
                  <span>Reads: helpdesk tickets, Mon–Fri</span>
                  <span>Writes: your format, your tone</span>
                  <span>Approver: you, before it’s sent</span>
                </div>
              )}
              {i === 2 && (
                <div class="art art--report" data-ui>
                  <b>Weekly report · Sample Freight Ltd</b>
                  <span>4 done · 3 waiting on you</span>
                  <em>Approved</em>
                </div>
              )}
              </div>
            </div>
            <p class="seg__clause" data-clause>
              <span class="sr-only">{s.time}. </span><strong>{s.lead}</strong> {s.text}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .how { position: relative; padding-block: var(--section); }
  .how__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; margin-bottom: clamp(40px, 5vw, 72px); }
  .how__head h2 { grid-column: 1 / 6; }
  .how__sub { grid-column: 6 / -1; max-width: 36ch; padding-bottom: 8px; }
  .how__track { position: relative; }
  .how__token {
    display: inline-block; margin-bottom: 12px; padding: 6px 12px;
    background: var(--field); color: var(--on-field); font-weight: 700; font-size: var(--step-small);
    font-variation-settings: 'wdth' 82;
  }
  .bar { display: flex; gap: 6px; }
  .seg { flex: var(--grow) 1 0; min-width: 12%; }
  .seg__block { position: relative; height: clamp(210px, 28vh, 260px); background: var(--surface); overflow: hidden; }
  .seg__time { position: absolute; z-index: 1; left: 20px; top: 18px; transition: color var(--dur-ui) ease; font-size: var(--step-title); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; max-width: 12ch; }
  .seg__fill { position: absolute; inset: 0; clip-path: inset(0 0 0 0); }
  .seg--1 .seg__fill { background: var(--muted); }
  .seg--2 .seg__fill { background: var(--field); }
  .seg--3 .seg__fill { background: var(--accent); }
  .seg--1.is-filled .seg__time, .seg--2.is-filled .seg__time { color: var(--on-field); }
  .seg--3.is-filled .seg__time { color: var(--on-accent); }

  /* each stage holds its own artefact inside the fill, so the scroll wipe reveals it */
  .art {
    position: absolute; left: 20px; right: 20px; bottom: 18px;
    font-size: var(--step-small); line-height: 1.3; font-variation-settings: 'wdth' 82;
  }
  .art--notes { display: flex; flex-wrap: wrap; gap: 6px; }
  .art--notes span { background: var(--bg); color: var(--ink); padding: 4px 8px; font-weight: 500; }
  .art--notes span:nth-child(1) { transform: rotate(-3deg); }
  .art--notes span:nth-child(2) { transform: rotate(2deg); }
  .art--spec, .art--report {
    display: grid; gap: 2px; max-width: 340px; padding: 10px 12px;
    background: var(--paper); color: var(--paper-ink); font-family: var(--font-doc); font-variation-settings: normal;
  }
  .art--spec b, .art--report b { font-weight: 600; }
  .art--report { right: auto; padding-right: 104px; }
  .art--report em {
    position: absolute; right: 10px; top: 50%; translate: 0 -50%; rotate: -6deg;
    font-style: normal; font-family: var(--font-sans); font-weight: 800; padding: 4px 8px;
    background: var(--field); color: var(--on-field);
  }  .seg__clause { margin-top: 18px; max-width: 30ch; line-height: 1.45; }
  .seg__clause strong { font-weight: 700; }

  @media (min-width: 1100px) {
    .how.is-pinned { height: 185vh; padding-block: 0; }
    .how.is-pinned .how__pin {
      position: sticky; top: 68px; height: calc(100svh - 68px);
      display: flex; flex-direction: column; justify-content: center;
    }
  }
  @media (max-width: 1099px) {
    .how__head { display: block; }
    .how__sub { margin-top: 16px; }
    .bar { flex-direction: column; }
    .seg { min-width: 0; }
    .seg__block { height: calc(var(--grow) * 46px + 70px); }
    .seg__clause { margin: 12px 0 18px; max-width: 46ch; }
    .how__token { display: none; }
  }
</style>

<script>
  import { scroll } from 'motion';
  import { reducedMotion } from '../lib/motion';

  const section = document.querySelector<HTMLElement>('[data-how]')!;
  const fills = [...section.querySelectorAll<HTMLElement>('[data-fill]')];
  const token = section.querySelector<HTMLElement>('[data-token]')!;
  const label = section.querySelector<HTMLElement>('[data-token-label]')!;
  const bar = section.querySelector<HTMLElement>('.bar')!;
  const names = ['Your notes', 'A workflow', 'Approved'];
  const grows = fills.map((f) => Number(getComputedStyle(f.closest('.seg')!).getPropertyValue('--grow')));
  const total = grows.reduce((a, b) => a + b, 0);
  const desktop = window.matchMedia('(min-width: 1100px)');

  if (!reducedMotion()) {
    let stop: VoidFunction | undefined;
    let travel = 0;
    let thresholds: number[] = [];
    const measure = () => {
      travel = bar.offsetWidth - token.offsetWidth;
      // flip each label's ink once the fill has passed the middle of the label
      thresholds = fills.map((f) => {
        const block = f.parentElement!;
        const label = block.querySelector<HTMLElement>('.seg__time')!;
        return desktop.matches
          ? (label.offsetLeft + label.offsetWidth / 2) / block.offsetWidth
          : (label.offsetTop + label.offsetHeight / 2) / block.offsetHeight;
      });
    };

    const render = (progress: number) => {
      const p = Math.min(1, Math.max(0, progress));
      let start = 0;
      let current = 0;
      fills.forEach((fill, i) => {
        const len = grows[i] / total;
        const local = Math.min(1, Math.max(0, (p - start) / len));
        if (local > 0) current = i;
        fill.closest('.seg')!.classList.toggle('is-filled', local > thresholds[i]);
        const hidden = ((1 - local) * 100).toFixed(2);
        fill.style.clipPath = desktop.matches ? `inset(0 ${hidden}% 0 0)` : `inset(0 0 ${hidden}% 0)`;
        fill.style.visibility = local > 0 ? 'visible' : 'hidden';
        start += len;
      });
      if (desktop.matches) {
        token.style.transform = `translateX(${(p * travel).toFixed(1)}px)`;
        if (label.textContent !== names[current]) label.textContent = names[current];
      }
    };

    const setup = () => {
      stop?.();
      section.classList.toggle('is-pinned', desktop.matches);
      measure();
      stop = scroll(render, {
        target: section,
        offset: desktop.matches ? ['start start', 'end end'] : ['start 0.75', 'end 0.6'],
      });
    };
    setup();
    desktop.addEventListener('change', setup);
    window.addEventListener('resize', measure);
  } else {
    label.textContent = names[2];
    section.querySelectorAll('.seg').forEach((s) => s.classList.add('is-filled'));
  }
</script>
