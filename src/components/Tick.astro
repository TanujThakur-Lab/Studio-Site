---
interface Props { class?: string; label?: string }
const { class: cls = 'tick', label } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}>
  <path d="M4 12.5l5 5L20 6.5" stroke="currentColor" stroke-width="3.2" stroke-linecap="square" stroke-linejoin="miter" />
</svg>
