---
import { BRAND, BOOKING_URL } from '../config';
const tiers = [
  {
    name: 'Workflow audit',
    who: 'For finding out whether it’s worth it.',
    body: 'We sit with the person who does the task, map it end to end, and give you a written plan: what to automate, what to leave alone, and the hours it should save. If it isn’t worth building, we’ll say so.',
    note: 'A small fixed fee',
  },
  {
    name: 'Fixed-price build',
    who: 'For one workflow, done properly.',
    body: 'We build it against your real data, test it beside the person who does the job today, and switch it on only when they’re happy with the drafts. One price, agreed in writing before we start.',
    note: 'A fixed price per workflow',
  },
  {
    name: 'Monthly plan',
    who: 'For keeping it right as you change.',
    body: 'We run it, watch it, fix it and improve it, and add the next workflow when you’re ready. Leave whenever you like with [notice period] notice; you keep everything we built.',
    note: 'A flat monthly fee',
  },
];
---
<section id="pricing" class="tiers" aria-labelledby="pricing-title">
  <div class="wrap grid tiers__head" data-reveal-group>
    <h2 class="headline" id="pricing-title" data-reveal="clip">Start small.</h2>
    <p class="tiers__sub" data-reveal>Three steps, and you can stop after any of them. We quote after the call, once we’ve seen the task.</p>
  </div>
  <div class="wrap tiers__sheet">
    <article class="proposal" data-ui aria-labelledby="proposal-title" data-reveal-group>
      <header class="proposal__head" data-reveal>
        <h3 class="proposal__title" id="proposal-title">Proposal: working with {BRAND}</h3>
        <p class="proposal__meta">Three stages · each one optional · pricing on request</p>
      </header>
      <ol class="proposal__items">
        {tiers.map((t, i) => (
          <li class:list={['item', { 'item--start': i === 0 }]} data-reveal>
            <div class="item__name">
              <h4>{t.name}</h4>
              <p>{t.who}</p>
            </div>
            <p class="item__body">{t.body}</p>
            <div class="item__price">
              <p>{t.note}</p>
              <a class="link" href={BOOKING_URL}>Ask about this<span class="sr-only">: {t.name}</span></a>
            </div>
          </li>
        ))}
      </ol>
      <footer class="proposal__foot" data-reveal>
        <p><strong>Pricing on request.</strong> Most people start with the audit.</p>
        <span class="proposal__sign" aria-hidden="true">Approved by: ____________</span>
      </footer>
    </article>
  </div>
</section>

<style>
  .tiers { padding-block: var(--section); }
  .tiers__head { align-items: end; row-gap: 20px; margin-bottom: clamp(40px, 5vw, 72px); }
  .tiers__head h2 { grid-column: 1 / 6; }
  .tiers__sub { grid-column: 6 / -1; max-width: 40ch; padding-bottom: 8px; }

  .proposal { background: var(--paper); color: var(--paper-ink); font-family: var(--font-doc); }
  .proposal :focus-visible { outline-color: var(--paper-ink); }
  .proposal__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; padding: clamp(22px, 3vw, 40px) clamp(20px, 3vw, 44px) 20px; }
  .proposal__title { font-family: var(--font-doc); font-weight: 600; font-size: var(--step-title); line-height: 1.15; letter-spacing: -0.01em; }
  .proposal__meta { font-family: var(--font-sans); font-size: var(--step-small); font-weight: 600; color: var(--paper-muted); }
  .item {
    display: grid; grid-template-columns: 4fr 6fr 3fr; gap: 12px var(--gutter);
    padding: 24px clamp(20px, 3vw, 44px); line-height: 1.5;
  }
  .item:nth-child(even) { background: var(--paper-tint); }
  .item--start { background: var(--accent); color: var(--on-accent); }
  .item__name h4 { font-family: var(--font-sans); font-size: var(--step-title); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
  .item__name p { margin-top: 6px; font-family: var(--font-sans); font-weight: 600; }
  .item__body { max-width: 52ch; }
  .item__price { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; font-family: var(--font-sans); }
  .item__price p { font-weight: 700; }
  .item__price .link { padding-block: 10px; }
  .proposal__foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px;
    padding: 20px clamp(20px, 3vw, 44px) clamp(22px, 3vw, 36px);
  }
  .proposal__sign { font-family: var(--font-sans); font-size: var(--step-small); color: var(--paper-muted); }
  @media (max-width: 1099px) {
    .item { grid-template-columns: 1fr 1fr; }
    .item__body { grid-column: 1 / -1; grid-row: 2; }
  }
  @media (max-width: 767px) {
    .tiers__sheet { padding-inline: 0; }
    .item { grid-template-columns: 1fr; }
    .item__body { grid-row: auto; }
  }
</style>
