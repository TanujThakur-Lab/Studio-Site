          // keep the words readable: slips fade out as they pass behind the text of the chapter
          if (mat.opacity > 0) {
            sp.copy(tmp).applyMatrix4(world.matrixWorld).project(camera);
            const sx = (sp.x * 0.5 + 0.5) * canvas.clientWidth, sy = (-sp.y * 0.5 + 0.5) * canvas.clientHeight;
            for (const r of rects) mat.opacity *= smooth(-20, 90, Math.max(r.left - sx, sx - r.right, r.top - sy, r.bottom === r.top ? 0 : sy - r.bottom));
          }
        }

        // the person
        person.setWellbeing(settle * 0.32 + flow * 0.14 + resolve * 0.24 + ret * 0.2 + calm * 0.1);
        if (!reduce) person.update(dt);
        // he only turns towards the draft in frame 4, then back to you
        figure.rotation.y = resolve * (small ? 0.2 : 0.45) * (1 - ret);

        // the room tidies itself as the work is handed over, and morning comes in
        const clutter = 1 - smooth(0.2, 1, flow);
        piles.forEach(({ p }) => { p.scale.y = Math.max(0.05, clutter); p.position.y = deskTop + 0.04 + (p.geometry as THREE.BoxGeometry).parameters.height * p.scale.y / 2; });
        notes.forEach((n, k) => { n.scale.setScalar(Math.max(0.0001, 1 - smooth(k / 18, k / 18 + 0.5, flow))); });
        plant.scale.setScalar(Math.max(0.0001, smooth(0.2, 0.8, ret)));
        screenMat.color.set(flow > 0.5 ? '#FFD84D' : '#FFFFFF');
        screenMat.opacity = 0.35 + 0.65 * (clutter * (0.85 + Math.sin(time * 9) * 0.15 * clutter));
        contact.material.opacity = 1 - smooth(0.6, 1, calm) * 0.4;
        const roomOpacity = 1 - smooth(0.2, 0.9, calm);
        roomMats.forEach((m) => { (m as THREE.MeshBasicMaterial).opacity = roomOpacity; });
        wallMat.opacity = roomOpacity;
        deskTopMesh.castShadow = roomOpacity > 0.5;
        wallShadowMat.opacity = 0.1 * roomOpacity;
        sunMat.opacity = calm;

        // the hour: the window and the wall clock both follow it
        const fi = Math.min(4, Math.floor(scene01));
        const ft = scene01 - fi;
        const hour = HOURS[fi] + (HOURS[fi + 1] - HOURS[fi]) * ft;
        if (Math.abs(hour - lastHour) > 0.01) { drawWindow(hour); lastHour = hour; }
        hourHand.rotation.z = -((hour % 12) / 12) * Math.PI * 2;
        minHand.rotation.z = -(hour % 1) * Math.PI * 2;

        // core and the returned clock
        const life = smooth(0.1, 0.9, flow);
        coreMat.uniforms.uLife.value = life;
        coreMat.uniforms.uTime.value = time;
        core.scale.setScalar(Math.max(0.0001, RING_R * 0.48 * life * (1 - resolve)));
        coreLight.intensity = 3 * life * (1 - resolve);
        clockMat.uniforms.uLife.value = ret * (1 - calm);
        clockMat.uniforms.uTime.value = time;
        clockBlob.scale.setScalar(Math.max(0.0001, (small ? 0.75 : 1.05) * smooth(0, 0.7, ret) * (1 + Math.sin(time * 0.7) * 0.025)));

        // colour of the world
        bgA.copy(FIELD[fi]).lerp(FIELD[fi + 1], ft);
        bgB.copy(FLOOR[fi]).lerp(FLOOR[fi + 1], ft);
        root.style.setProperty('--field', '#' + bgA.getHexString());
        wallMat.color.copy(bgA);
        floorMat.color.copy(bgB);
        const lum = bgA.r * 0.2126 + bgA.g * 0.7152 + bgA.b * 0.0722;
        root.style.setProperty('--bar', lum < 0.2 ? '#F2F2F2' : '#0A0A0A');

        // labels pinned to the 3D shapes
        const labelsIn = smooth(0.85, 1, p1) * (1 - smooth(0, 0.2, flow));
        sliceLabels.forEach((el, k) => {
          const a = (sliceStart[k] + perSlice[k] / total / 2) * Math.PI * 2 - Math.PI / 2 - turn;
          const lr = RING_R + (small ? 0.75 : 1.1);
          place(el, tmp.set(RING_X + Math.cos(a) * lr, Math.sin(a) * lr + RING_Y, RING_Z), labelsIn);
        });
        place(hub, tmp.copy(ringCentre), labelsIn);
        place(coreEl, tmp.copy(ringCentre).add(new THREE.Vector3(0, RING_R * 0.48 * life + 0.35, 0)), smooth(0.5, 0.9, flow) * (1 - smooth(0, 0.4, resolve)));
        place(timeWord, tmp.copy(blobPos), smooth(0.45, 0.8, ret) * (1 - smooth(0, 0.3, calm)));

        renderer.render(scene, camera);
      }

      let last = performance.now();
      function loop(now: number) {
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        time += dt;
        // travel towards the section in view at each transition's own pace (seconds per frame change);
        // flood → clock is the big one, so it gets the longest. Catch up faster if several sections behind.
        const gap = Math.abs(target - scene01);
        if (gap > 0) {
          const forward = target > scene01;
          const seg = Math.min(4, Math.max(0, forward ? Math.floor(scene01 + 1e-6) : Math.ceil(scene01 - 1e-6) - 1));
          const step = (dt / TRANSITION[seg]) * (gap > 1 ? 1 + (gap - 1) * 1.5 : 1);
          scene01 = forward ? Math.min(target, scene01 + step) : Math.max(target, scene01 - step);
        }
        render(dt);
        requestAnimationFrame(loop);
      }

      resize();
      readScroll();
      if (reduce) render(0); else requestAnimationFrame(loop);

      // the unread counter keeps climbing while the flood is on screen
      if (!reduce) {
        const counter = $('[data-count]');
        let n = 214;
        const tick = () => {
          if (target === 0 && document.visibilityState === 'visible') { n += 1 + Math.floor(Math.random() * 3); counter.textContent = String(n); }
          setTimeout(tick, 700 + Math.random() * 900);
        };
        setTimeout(tick, 1200);
      }
    </script>
  </body>
</html>
