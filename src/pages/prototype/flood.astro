---
// Prototype of the full OGC Studio journey, storyboard frames 1–6, as a real scrolling page:
// six sections of content scroll normally over a fixed 3D world, and each section that arrives
// sets the scene's target, which the scene then eases to over about a second.
// Not linked from the live homepage.
import '@fontsource-variable/albert-sans';
import { BOOKING_URL } from '../../config';

// Six sample automations for frame 4. Every name, number and address is made up.
const AUTOMATIONS = [
  { id: 'report', tab: 'Weekly report', trigger: 'every Friday, 4 pm, from 23 tickets', title: 'Weekly report · Sample Freight Ltd', to: 'Sample Freight Ltd',
    items: ['Customs hold cleared, documents re-sent', 'Invoice mismatch corrected', 'Bill of lading approved', '3 items waiting on you'] },
  { id: 'chaser', tab: 'Invoice chaser', trigger: 'daily, from your accounts sheet', title: 'Reminder: invoice INV-2291 is 14 days overdue', meta: 'To: accounts@demo-exports.example · ₹1,84,500', to: 'Demo Exports',
    body: 'Hi Arjun, a quick reminder that invoice INV-2291 for ₹1,84,500 was due on 14 October. Could you let us know when payment is scheduled? A copy is attached.' },
  { id: 'delay', tab: 'Delay notice', trigger: 'when the carrier changes an ETA', title: 'Shipment SF-1188 now arrives Thursday', meta: 'To: 6 affected clients · personalised for each', to: 'the 6 affected clients',
    body: 'Your shipment SF-1188 is now due at Jebel Ali on Thursday 30 October, two days later than planned. Nothing is needed from you; we’ll confirm the delivery slot on Wednesday.' },
  { id: 'actions', tab: 'Meeting actions', trigger: 'after each recorded meeting', title: 'Monday ops meeting: actions', to: 'the 4 people in the meeting',
    items: ['Priya: update the rate sheet by Wednesday', 'Ravi: chase the delivery order from the line', 'Meera: send the new SOP for sign-off', 'You: approve the Q4 freight budget'] },
  { id: 'rates', tab: 'Rate sheet', trigger: 'when a new rate notice arrives', title: '3 changes from the March rate notice', meta: 'Updates the rate sheet, proposal template and 4 open quotes', to: 'your shared drive',
    items: ['20ft Nhava Sheva to Jebel Ali: ₹48,500 → ₹52,000', 'Documentation fee: ₹2,500 → ₹3,000', 'Free days at destination: 7 → 5'] },
  { id: 'ticket', tab: 'Ticket reply', trigger: 'for routine helpdesk tickets', title: 'Re: Ticket #4821 “Where is my container?”', meta: 'To: Meera, Example Consulting LLP', to: 'Example Consulting LLP',
    body: 'Hi Meera, your container SFXU 482119 cleared customs this morning and is booked for delivery on Thursday between 10 am and 1 pm. I’ll send the proof of delivery as soon as it lands.' },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>OGC Studio · prototype: the journey</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="#f1">OGC Studio</a>
      <button class="theme" type="button" aria-label="Theme switch (coming soon)" disabled>Theme</button>
      <a class="cta" href={BOOKING_URL}>Book a call</a>
    </header>

    <!-- the fixed world behind the page: his office, painted in the colour of the hour -->
    <div class="world" aria-hidden="true">
      <canvas data-canvas></canvas>
      <p class="slice-label" data-slice="0" style="--c:#FFC013">Reports</p>
      <p class="slice-label" data-slice="1" style="--c:#FF6A3D">Follow-ups</p>
      <p class="slice-label" data-slice="2" style="--c:#4D8FE0">Doc updates</p>
      <p class="slice-label" data-slice="3" style="--c:#3FAE7A">Replies</p>
      <p class="hub" data-hub><b>40 h</b><span>one working week</span></p>
      <p class="core-label" data-core>OGC</p>
      <p class="time-word" data-time-word>Friday<br />3 pm<br />is yours</p>
    </div>

    <main>
      <section class="frame" id="f1" data-frame aria-labelledby="t1">
        <p class="count"><b data-count>214</b><span>unread, and it’s 7:58 am</span></p>
        <div class="panel">
          <h1 id="t1">Your week, already full.</h1>
          <p>Reports, chasers, replies, updates: the same admin as last week, all arriving at once. OGC Studio builds the AI workflows that take it off you.</p>
        </div>
        <p class="hint">Scroll to start the day</p>
      </section>

      <section class="frame" id="f2" data-frame aria-labelledby="t2">
        <div class="panel">
          <h2 id="t2">Every hour spoken for.</h2>
          <p>By ten the messages have settled into a week drawn as a clock, carved into the same four kinds of repeat work.</p>
          <p class="stat"><b>40 h</b> one working week</p>
        </div>
      </section>

      <section class="frame" id="f3" data-frame aria-labelledby="t3">
        <div class="panel">
          <h2 id="t3">Hand the repeats over.</h2>
          <p>We turn that work into a workflow. The messages stop landing on you and flow into one place that drafts it.</p>
        </div>
      </section>

      <section class="frame frame--split" id="f4" data-frame aria-labelledby="t4">
        <div class="panel">
          <h2 id="t4">Sent only on your yes.</h2>
          <p>Out comes one finished draft. You read it, press approve, and it goes. Try six of the workflows we build.</p>
        </div>
        <div class="automations" data-automations>
          <div class="auto-tabs" role="tablist" aria-label="Sample automations">
            {AUTOMATIONS.map((a, i) => (
              <button type="button" role="tab" id={`tab-${a.id}`} aria-controls={`auto-${a.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{a.tab}</button>
            ))}
          </div>
          {AUTOMATIONS.map((a, i) => (
            <article class="approval" id={`auto-${a.id}`} role="tabpanel" aria-labelledby={`tab-${a.id}`} hidden={i !== 0} data-to={a.to}>
              <p class="ap-sample">Sample data · {a.trigger}</p>
              <h3>{a.title}</h3>
              {a.meta && <p class="ap-meta">{a.meta}</p>}
              {a.body && <p class="ap-body">{a.body}</p>}
              {a.items && <ul>{a.items.map((t) => <li>{t}</li>)}</ul>}
              <div class="ap-foot">
                <span data-ap-state aria-live="polite">Draft · nothing is sent until you approve</span>
                <button type="button" data-ap-approve>
                  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" /></svg>
                  Approve
                </button>
              </div>
              <span class="ap-stamp" aria-hidden="true">Approved</span>
            </article>
          ))}
        </div>
      </section>

      <section class="frame" id="f5" data-frame aria-labelledby="t5">
        <div class="panel">
          <h2 id="t5">The hours come back.</h2>
          <p>By half past five the clock returns, empty and soft. The slices that were admin are open time again.</p>
          <p class="time-back"><b>[ x h ]</b> back this week</p>
        </div>
      </section>

      <section class="frame frame--dark frame--last" id="f6" data-frame aria-labelledby="t6">
        <div class="panel">
          <h2 id="t6">Get your time back.</h2>
          <p>Start with one task. The evening is yours; the drafts wait for your yes in the morning.</p>
        </div>
      </section>

      <section class="close" aria-labelledby="t7">
        <a class="band" href={BOOKING_URL}>
          <span class="band-note">A free 20-minute call. We’ll tell you honestly whether it’s worth automating.</span>
          <svg class="band-arrow" viewBox="0 0 48 48" aria-hidden="true"><path d="M12 36L36 12M16 12h20v20" fill="none" stroke="currentColor" stroke-width="4" /></svg>
          <h2 class="band-word" id="t7">Book</h2>
        </a>
      </section>
    </main>

    <style is:global>
      :root {
        --field: #CBE4F2; --ink: #0A0A0A; --paper: #FFFFFF; --muted: #44606E; --bar: #0A0A0A;
        --accent: #B0298F; --accent-ink: #FFFFFF; --alarm: #C81E1E;
        --font: 'Albert Sans Variable', 'Albert Sans', system-ui, sans-serif;
        --step-small: clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem);
        --step-body: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
        --step-lead: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
        --step-head: clamp(2rem, 1.3rem + 3.2vw, 4rem);
        --step-display: clamp(2.75rem, 0.9rem + 5.4vw, 6rem);
        --m: clamp(16px, 4vw, 56px);
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      }
      * { box-sizing: border-box; }
      html { background: var(--field); }
      body { margin: 0; color: var(--ink); font-family: var(--font); font-size: var(--step-body); line-height: 1.5; -webkit-font-smoothing: antialiased; }
      :focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }

      /* nav: wordmark, one quiet placeholder, one action; its ink follows the chapter beneath */
      .bar { position: fixed; inset: 0 0 auto; z-index: 10; display: flex; align-items: center; gap: 8px; padding: 16px var(--m); color: var(--bar); transition: color 300ms ease; }
      .brand { margin-right: auto; padding: 10px 0; font-weight: 600; font-size: var(--step-lead); letter-spacing: -0.03em; color: inherit; text-decoration: none; }
      .theme { min-height: 44px; padding: 0 12px; border: 0; background: none; color: inherit; font: 500 14px var(--font); opacity: 0.55; }
      .cta { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: var(--step-body); text-decoration: none; transition: transform 160ms var(--ease-out), background-color 160ms ease; }
      .cta:active { transform: scale(0.97); }
      @media (hover: hover) and (pointer: fine) { .cta:hover { background: #8E1F73; } }
      @media (max-width: 700px) { .theme { display: none; } .brand { font-size: 20px; } }

      /* the fixed 3D world: one flat field of the hour's colour */
      .world { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: var(--field); }
      .world canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .slice-label, .hub, .core-label, .time-word { position: absolute; left: 0; top: 0; margin: 0; opacity: 0; pointer-events: none; translate: -50% -50%; will-change: transform; }
      .slice-label { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: var(--step-body); letter-spacing: -0.01em; white-space: nowrap; color: var(--ink); }
      .slice-label::before { content: ''; width: 12px; height: 12px; background: var(--c); }
      .hub { display: none; }
      .core-label { font-weight: 600; font-size: var(--step-lead); letter-spacing: -0.03em; color: #FFFFFF; }
      .time-word { text-align: center; font-weight: 600; font-size: var(--step-lead); line-height: 1.02; letter-spacing: -0.03em; color: var(--ink); }

      /* the page that scrolls over it: every chapter's heading starts on the same left edge */
      main { position: relative; z-index: 1; }
      .frame { position: relative; min-height: 115vh; display: flex; align-items: flex-end; gap: 32px; padding: 120px var(--m) clamp(56px, 12vh, 128px); }
      #f1 { min-height: 100svh; }
      .frame--split { justify-content: space-between; align-items: flex-end; flex-wrap: wrap; }
      .frame--last { min-height: 100svh; }
      .frame--dark { color: var(--bar); transition: color 300ms ease; }
      .panel { max-width: min(46vw, 700px); }
      .panel h1, .panel h2 { margin: 0 0 24px; font-weight: 600; font-size: var(--step-display); line-height: 0.98; letter-spacing: -0.035em; text-wrap: balance; }
      .panel p { margin: 0; max-width: 36ch; font-size: var(--step-lead); line-height: 1.4; }
      .count { position: absolute; right: var(--m); top: clamp(88px, 15vh, 140px); margin: 0; text-align: right; }
      .count b { display: block; font-weight: 600; font-size: clamp(64px, 9vw, 140px); line-height: 0.9; letter-spacing: -0.045em; color: var(--alarm); font-variant-numeric: tabular-nums; }
      .count span { font-weight: 500; font-size: var(--step-body); }
      .hint { position: absolute; left: 50%; bottom: 20px; translate: -50% 0; margin: 0; font-weight: 500; font-size: 14px; }
      .panel .stat, .panel .time-back { margin-top: 28px; font-size: var(--step-body); font-weight: 500; }
      .stat b, .time-back b { display: block; font-weight: 600; font-size: var(--step-head); line-height: 1; letter-spacing: -0.04em; }

      /* the draft to approve: plain paper, square corners, nothing floating at rest */
      .automations { width: min(440px, 100%); display: grid; gap: 8px; }
      .auto-tabs { display: flex; flex-wrap: wrap; gap: 4px; }
      .auto-tabs button {
        min-height: 44px; padding: 0 14px; border: 0; background: var(--paper); color: var(--ink); font: 500 var(--step-body) var(--font); cursor: pointer;
        transition: background-color 160ms ease, color 160ms ease, transform 160ms var(--ease-out);
      }
      @media (hover: hover) and (pointer: fine) { .auto-tabs button:hover { background: #E6E6E6; } }
      .auto-tabs button:active { transform: scale(0.96); }
      .auto-tabs button[aria-selected='true'] { background: var(--ink); color: var(--paper); }
      .approval { position: relative; padding: 24px; background: var(--paper); color: var(--ink); }
      .approval h3 { margin: 6px 0 10px; font-size: var(--step-lead); font-weight: 600; line-height: 1.25; letter-spacing: -0.015em; }
      .approval ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: var(--step-body); }
      .approval li::before { content: ''; display: inline-block; width: 7px; height: 7px; background: var(--ink); margin: 0 10px 2px 0; }
      .ap-sample { margin: 0; font-size: 14px; font-weight: 500; color: var(--muted); }
      .ap-meta { margin: -2px 0 10px; font-size: 14px; color: var(--muted); }
      .ap-body { margin: 0; font-size: var(--step-body); line-height: 1.5; }
      .ap-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 20px; }
      .ap-foot span { font-size: 14px; line-height: 1.35; color: var(--muted); }
      .ap-foot button { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 20px; border: 0; flex: none; background: var(--ink); color: var(--paper); font: 600 var(--step-body) var(--font); cursor: pointer; transition: transform 160ms var(--ease-out), background-color 160ms ease; }
      .ap-foot button:active { transform: scale(0.96); }
      .ap-stamp { position: absolute; right: 16px; top: 14px; padding: 6px 12px; background: var(--ink); color: var(--paper); font-weight: 600; font-size: 14px;
        opacity: 0; transform: rotate(-6deg) scale(1.4); transition: opacity 200ms ease, transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1); }
      .approval.is-approved .ap-stamp { opacity: 1; transform: rotate(-6deg) scale(1); }
      .approval.is-approved .ap-foot button { background: rgba(10, 10, 10, 0.1); color: var(--ink); }

      /* the close: one word is the button */
      .close { position: relative; z-index: 1; }
      .band {
        display: grid; grid-template: 'note arrow' auto 'word word' 1fr / 1fr auto; gap: 24px; min-height: 64svh; padding: 28px var(--m) 24px;
        background: var(--accent); color: var(--accent-ink); text-decoration: none; overflow: hidden;
      }
      .band:hover, .band:focus-visible { background: var(--accent-ink); color: var(--accent); }
      .band:focus-visible { outline: 4px solid var(--accent); outline-offset: -10px; }
      .band-note { grid-area: note; max-width: 30ch; font-weight: 500; font-size: var(--step-lead); line-height: 1.35; }
      .band-arrow { grid-area: arrow; width: 48px; height: 48px; }
      .band-word { grid-area: word; align-self: end; margin: 0 0 0 -0.075em; font-weight: 700; font-size: clamp(120px, 41.5vw, 720px); line-height: 0.74; letter-spacing: -0.06em; }
      @media (max-width: 700px) {
        .band { min-height: 46svh; }
        .band-arrow { width: 32px; height: 32px; }
      }

      /* sections arrive with a short rise as they scroll in */
      .js .panel > *, .js .automations, .js .count { opacity: 0; transform: translateY(28px); transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-out); }
      .js .panel > :nth-child(2) { transition-delay: 80ms; }
      .js .panel > :nth-child(3), .js .automations { transition-delay: 160ms; }
      .js .is-in .panel > *, .js .is-in .automations, .js .is-in .count { opacity: 1; transform: none; }

      @media (max-width: 700px) {
        .frame { padding-top: 96px; }
        .panel { max-width: none; margin-inline: calc(var(--m) * -1); padding: 20px var(--m) 24px; background: var(--field); }
        .frame--split { flex-direction: column; align-items: stretch; justify-content: flex-end; }
        .count { top: 80px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .js .panel > *, .js .automations, .js .count { transition: none; }
      }
    </style>

    <script>
      import * as THREE from 'three';
      import { loadPerson } from '../../lib/personModel';

      document.documentElement.classList.add('js');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const small = window.matchMedia('(max-width: 700px)').matches;
      const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
      const canvas = $<HTMLCanvasElement>('[data-canvas]');
      const sections = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
      const root = document.documentElement;

      // ── sample messages and the clock slice each one falls into ──
      const SLICES = ['#FFC013', '#FF6A3D', '#4D8FE0', '#3FAE7A'];
      const MESSAGES: [string, number][] = [
        ['Reminder: weekly report due', 0], ['Client: any update on the shipment?', 3], ['#4812 customs hold', 1],
        ['3 missed calls', 3], ['Invoice mismatch, please check', 1], ['Re: Re: Re: documents', 3],
        ['Update the rate sheet', 2], ['KYC documents overdue', 1], ['Slack: 27 new messages', 3],
        ['Chase the supplier', 1], ['Meeting moved to 4 pm', 3], ['Monthly summary for Sample Co.', 0],
        ['Can you resend the BL?', 3], ['Proposal template still says 2025', 2], ['ETA again??', 1],
        ['Ticket #4821 reopened', 0], ['Sign-off needed on SOP v3', 2], ['Where are we with this?', 1],
        ['Timesheets due today', 0], ['New starter details', 2],
      ];

      // ── renderer, scene, camera, lights ──
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setClearColor(0x000000, 0);
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 90);
      scene.add(camera);
      const world = new THREE.Group();
      scene.add(world);
      const ambient = new THREE.AmbientLight(0xffffff, 0.55);
      const hemi = new THREE.HemisphereLight(0xffffff, 0xd9d2c5, 1.1);
      scene.add(ambient, hemi);

      // ── the person ──
      const person = await loadPerson();
      const figure = person.group;
      // he never moves: everything in the story happens around this spot
      const P_X = small ? 0 : 1.0;
      const FEET = small ? -1.9 : -2.05;
      figure.scale.setScalar(small ? 1.45 : 1.7);
      figure.position.set(P_X, FEET, 0);

      // ── his office: a simple room that changes with the story ──
      const room = new THREE.Group();
      world.add(room);
      const roomMats: THREE.Material[] = [];
      const solid = (color: string) => { const m = new THREE.MeshStandardMaterial({ color, roughness: 0.92, transparent: true }); roomMats.push(m); return m; };
      const box = (w: number, h: number, d: number, m: THREE.Material, x: number, y: number, z: number) => {
        const b = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m);
        b.position.set(x, y, z);
        room.add(b);
        return b;
      };
      // wall and floor are the page's own colour field: unlit, exact, and shadows laid over them
      const wallMat = new THREE.MeshBasicMaterial({ color: '#CBE4F2', toneMapped: false, transparent: true });
      const floorMat = new THREE.MeshBasicMaterial({ color: '#B6D2E2', toneMapped: false });
      const floorGeo = new THREE.PlaneGeometry(80, 70);
      const wallGeo = new THREE.PlaneGeometry(80, 24);
      const floor = new THREE.Mesh(floorGeo, floorMat);
      floor.rotation.x = -Math.PI / 2;
      floor.position.set(P_X, FEET, -6);
      const wall = new THREE.Mesh(wallGeo, wallMat);
      wall.position.set(P_X, FEET + 11, -5);
      const floorShadow = new THREE.Mesh(floorGeo, new THREE.ShadowMaterial({ opacity: 0.16 }));
      floorShadow.rotation.x = -Math.PI / 2;
      floorShadow.position.set(P_X, FEET + 0.003, -6);
      floorShadow.receiveShadow = true;
      const wallShadowMat = new THREE.ShadowMaterial({ opacity: 0.1 });
      const wallShadow = new THREE.Mesh(wallGeo, wallShadowMat);
      wallShadow.position.set(P_X, FEET + 11, -4.99);
      wallShadow.receiveShadow = true;
      room.add(floor, wall, floorShadow, wallShadow);
      // the sun that sets behind the floor at the end of the day
      const sunMat = new THREE.MeshBasicMaterial({ color: '#FFC013', toneMapped: false, transparent: true, opacity: 0 });
      const sunDisc = new THREE.Mesh(new THREE.CircleGeometry(small ? 2.6 : 3.6, 64), sunMat);
      sunDisc.position.set(P_X + (small ? 0 : 1.6), FEET - 0.4, -36);
      world.add(sunDisc);

      // the window behind him: its sky follows the clock, hour by hour
      const WIN = { w: small ? 2.6 : 3.6, h: small ? 1.9 : 2.5, x: P_X - (small ? 0 : 0.3), y: FEET + (small ? 3.2 : 3.5), z: -4.95 };
      const winCanvas = document.createElement('canvas');
      winCanvas.width = 512; winCanvas.height = 356;
      const winG = winCanvas.getContext('2d')!;
      const winTex = new THREE.CanvasTexture(winCanvas);
      winTex.colorSpace = THREE.SRGBColorSpace;
      winTex.anisotropy = 8;
      const winMat = new THREE.MeshBasicMaterial({ map: winTex, toneMapped: false, transparent: true });
      roomMats.push(winMat);
      const win = new THREE.Mesh(new THREE.PlaneGeometry(WIN.w, WIN.h), winMat);
      win.position.set(WIN.x, WIN.y, WIN.z);
      room.add(win);
      // [hour, sky, far towers, near towers, sun x, sun y (0 = top, 1 = horizon)]
      const SKY: [number, string, string, string, number, number][] = [
        [7.97, '#F7D9BC', '#D9B39A', '#A88470', 0.2, 0.8],   // 7:58 am: low sun, pale morning
        [10, '#B4DCF4', '#8FB5CC', '#6A8EA5', 0.34, 0.42],
        [13, '#86C8F0', '#7DA9C4', '#55809A', 0.56, 0.14],   // midday, sun high
        [15, '#9FD0EE', '#86ABC1', '#5D8299', 0.72, 0.34],
        [17.5, '#F5A35A', '#CF7E4F', '#8E4F36', 0.84, 0.74], // golden hour
        [18.75, '#24304A', '#1B2438', '#111827', 0.9, 1.2],  // evening, the city lights come on
      ];
